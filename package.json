{
  "name": "wf-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-beta.59",
    "effect": "4.0.0-beta.59"
  },
  "scripts": {
    "build": "bun run --cwd packages/wf build",
    "build:cli": "bun run --cwd apps/cli build",
    "build:marketing": "bun run --cwd apps/marketing build",
    "cli": "bun run apps/cli/src/main.ts",
    "dev:marketing": "bun run --cwd apps/marketing dev",
    "dev:cli": "bun run apps/cli/src/main.ts",
    "example:email": "bun run examples/email/main.ts",
    "example:quickstart": "bun run examples/quickstart/main.ts",
    "example:order-saga": "cd examples/order-saga && bun run main.ts",
    "example:approval": "cd examples/approval && bun run main.ts demo",
    "install:local": "bun run apps/cli/install-local.ts",
    "prepare": "effect-language-service patch",
    "typecheck": "tsc --build --noEmit",
    "test": "bun test",
    "verify": "bun run typecheck && bun test && bun run example:order-saga && bun run example:approval && bun run build && bun run build:marketing && bun run build:cli",
    "wf": "bun run apps/cli/src/main.ts"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.4",
    "@types/bun": "latest",
    "effect-solutions": "^0.5.3",
    "typescript": "^6.0.3"
  }
}
