{
  "name": "wf-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "apps/wf/*",
    "packages/*",
    "examples/*"
  ],
  "catalog": {
    "@astrojs/check": "^0.9.5",
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/sql-sqlite-bun": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "@tailwindcss/vite": "^4.3.2",
    "@types/bun": "^1.3.14",
    "@types/dagre": "^0.7.53",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "astro": "^5.16.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dagre": "^0.8.5",
    "effect": "4.0.0-rc.115",
    "lucide-react": "^1.23.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reactflow": "^11.11.4",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.1",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "build:observability": "bun run --cwd packages/observability build",
    "build:wf": "bun run build:observability && bun run --cwd packages/wf build",
    "build": "bun run build:wf",
    "build:cli": "bun run build:wf && bun run --cwd apps/cli build",
    "build:marketing": "bun run --cwd apps/marketing build",
    "build:docs": "cd apps/docs && uv run --no-project --with-requirements requirements.txt mkdocs build",
    "build:site": "bun run build:marketing && bun run build:docs",
    "cli": "bun run apps/cli/src/main.ts",
    "dev:marketing": "bun run --cwd apps/marketing dev",
    "dev:dashboard": "bun run --cwd apps/wf/web dev",
    "build:dashboard": "bun run --cwd apps/wf/web build",
    "dev:cli": "bun run apps/cli/src/main.ts",
    "example:email": "bun run examples/email/main.ts",
    "example:quickstart": "bun run examples/quickstart/main.ts",
    "example:order-saga": "cd examples/order-saga && bun run main.ts",
    "example:approval": "cd examples/approval && bun run main.ts demo",
    "example:campaign-rollout": "cd examples/campaign-rollout && bun run main.ts",
    "install:local": "bun run apps/cli/install-local.ts",
    "refresh": "bun run scripts/refresh.ts",
    "lint": "oxlint",
    "prepare": "effect-language-service patch",
    "typecheck": "tsc --build --noEmit && tsc -p apps/wf/web",
    "test": "bun --bun vitest run",
    "test:all": "bun run test && bun run example:email && bun run example:quickstart && bun run example:order-saga && bun run example:approval && bun run example:campaign-rollout",
    "verify": "bun run lint && bun run typecheck && bun run test:all && bun run build:cli && bun run build:site && bun run build:dashboard",
    "wf": "bun run apps/cli/src/main.ts",
    "test:watch": "bun --bun vitest"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "1.79.0",
    "@types/bun": "catalog:",
    "effect-solutions": "^0.5.3",
    "oxlint": "1.79.0",
    "typescript": "^6.0.3",
    "vitest": "catalog:"
  }
}
