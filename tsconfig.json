{
  "$schema": "https://raw.githubusercontent.com/Effect-TS/language-service/refs/heads/main/schema.json",
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "ignoreDeprecations": "6.0",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun"],

    // Bundler mode
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@mokronos/observability": ["packages/observability/src/index.ts"],
      "@mokronos/wfkit": ["packages/wf/src/index.ts"],
      "@mokronos/wfkit/optional": ["packages/wf/src/optional.ts"],
      "@mokronos/wfkit/authoring": ["packages/wf/src/authoring.ts"],
      "@mokronos/wfkit/schemas": ["packages/wf/src/schemas.ts"],
      "@mokronos/wfkit/testing": ["packages/wf/src/testing/index.ts"]
    },
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "incremental": true,
    "composite": true,
    "sourceMap": true,
    "declarationMap": true,

    // Best practices
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ]
  },
  // The React app owns an `@/*` alias and is type-checked through its own
  // project instead — see the `typecheck` script.
  // The vendored anti-slop Oxlint plugin is third-party tooling source, not
  // owned project source: it is type-checked upstream and does not compile
  // under this repo's stricter options. Oxlint ignores it too.
  "exclude": [
    "**/dist",
    "node_modules",
    "**/.tmp/**",
    "apps/wf/web",
    "tools/oxlint/anti-slop"
  ]
}
