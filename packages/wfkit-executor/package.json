{
  "name": "@mokronos/wfkit-executor",
  "version": "0.2.0",
  "type": "module",
  "description": "The Executor-backed integration host for wfkit.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokronos/wf.git",
    "directory": "packages/wfkit-executor"
  },
  "homepage": "https://github.com/mokronos/wf#readme",
  "keywords": [
    "workflow",
    "integration",
    "executor",
    "mcp",
    "openapi"
  ],
  "engines": {
    "bun": ">=1.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "bun": "./src/schemas.ts",
      "development": "./src/schemas.ts",
      "default": "./dist/schemas.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@executor-js/fumadb": "1.5.7",
    "@executor-js/plugin-mcp": "1.5.37",
    "@executor-js/plugin-openapi": "1.5.37",
    "@executor-js/sdk": "1.5.37",
    "@libsql/client": "0.17.3",
    "drizzle-orm": "0.45.2",
    "effect": "4.0.0-beta.59"
  }
}
